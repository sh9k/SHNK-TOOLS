<Window x:Class="SHNK.Tools.App.DownloadProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="650"
        Height="430"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="True">

    <Window.Resources>

        <!-- ================= COLORS ================= -->

        <SolidColorBrush x:Key="TextMuted"
                         Color="#A0AAB5"/>

        <LinearGradientBrush x:Key="ProgressGradient"
                             StartPoint="0,0"
                             EndPoint="1,0">

            <GradientStop Color="#00F2FE"
                          Offset="0"/>

            <GradientStop Color="#4FACFE"
                          Offset="0.5"/>

            <GradientStop Color="#8A2BE2"
                          Offset="1"/>

        </LinearGradientBrush>


        <!-- ================= MAIN RINGS ANIMATION ================= -->

        <Storyboard x:Key="SpinAnimation">

            <!-- OUTER RING -->

            <DoubleAnimation
                Storyboard.TargetName="OuterRing"
                Storyboard.TargetProperty=
                "(UIElement.RenderTransform).(RotateTransform.Angle)"
                From="0"
                To="360"
                Duration="0:0:12"
                RepeatBehavior="Forever"/>


            <!-- INNER RING -->

            <DoubleAnimation
                Storyboard.TargetName="InnerRing"
                Storyboard.TargetProperty=
                "(UIElement.RenderTransform).(RotateTransform.Angle)"
                From="360"
                To="0"
                Duration="0:0:18"
                RepeatBehavior="Forever"/>


            <!-- MAIN PROGRESS RING -->

            <DoubleAnimation
                Storyboard.TargetName="MainProgressRing"
                Storyboard.TargetProperty=
                "(UIElement.RenderTransform).(RotateTransform.Angle)"
                From="135"
                To="495"
                Duration="0:0:4"
                RepeatBehavior="Forever"/>

        </Storyboard>


        <!-- ================= FLOATING OBJECTS ================= -->

        <Storyboard x:Key="FloatingAnimation">

            <DoubleAnimation
                Storyboard.TargetName="Cube1"
                Storyboard.TargetProperty=
                "(UIElement.RenderTransform).(TranslateTransform.Y)"
                From="0"
                To="-18"
                Duration="0:0:2.5"
                AutoReverse="True"
                RepeatBehavior="Forever"/>

            <DoubleAnimation
                Storyboard.TargetName="Cube2"
                Storyboard.TargetProperty=
                "(UIElement.RenderTransform).(TranslateTransform.Y)"
                From="0"
                To="15"
                Duration="0:0:3"
                AutoReverse="True"
                RepeatBehavior="Forever"/>

            <DoubleAnimation
                Storyboard.TargetName="Cube3"
                Storyboard.TargetProperty=
                "(UIElement.RenderTransform).(TranslateTransform.Y)"
                From="0"
                To="-22"
                Duration="0:0:2"
                AutoReverse="True"
                RepeatBehavior="Forever"/>

        </Storyboard>


        <!-- ================= GLOW PULSE ================= -->

        <Storyboard x:Key="PulseAnimation">

            <DoubleAnimation
                Storyboard.TargetName="CoreGlow"
                Storyboard.TargetProperty="Opacity"
                From="0.08"
                To="0.28"
                Duration="0:0:1.8"
                AutoReverse="True"
                RepeatBehavior="Forever"/>

        </Storyboard>


        <!-- ================= CANCEL BUTTON ================= -->

        <Style x:Key="CancelButton"
               TargetType="Button">

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="Background"
                    Value="#20FFFFFF"/>

            <Setter Property="BorderBrush"
                    Value="#55FFFFFF"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="Padding"
                    Value="24,9"/>

            <Setter Property="FontSize"
                    Value="12"/>

            <Setter Property="FontWeight"
                    Value="Bold"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

    </Window.Resources>


    <!-- ================= START ANIMATIONS ================= -->

    <Window.Triggers>

        <EventTrigger RoutedEvent="Window.Loaded">

            <BeginStoryboard
                Storyboard="{StaticResource SpinAnimation}"/>

            <BeginStoryboard
                Storyboard="{StaticResource FloatingAnimation}"/>

            <BeginStoryboard
                Storyboard="{StaticResource PulseAnimation}"/>

        </EventTrigger>

    </Window.Triggers>


    <!-- ================= MAIN CONTAINER ================= -->

    <Border CornerRadius="20"
            BorderThickness="1"
            BorderBrush="#35FFFFFF"
            ClipToBounds="True">

        <Border.Background>

            <RadialGradientBrush
                Center="0.5,0.45"
                GradientOrigin="0.5,0.45"
                RadiusX="0.8"
                RadiusY="0.8">

                <GradientStop
                    Color="#18213D"
                    Offset="0"/>

                <GradientStop
                    Color="#090C18"
                    Offset="1"/>

            </RadialGradientBrush>

        </Border.Background>


        <Border.Effect>

            <DropShadowEffect
                Color="#00F2FE"
                BlurRadius="35"
                ShadowDepth="0"
                Opacity="0.45"/>

        </Border.Effect>


        <Grid>


            <!-- ================= BACKGROUND GRID ================= -->

            <Canvas Opacity="0.08">

                <Path
                    Stroke="#00F2FE"
                    StrokeThickness="0.6"
                    Data="M0,60 L650,120
                          M0,160 L650,100
                          M0,270 L650,330
                          M100,0 L250,430
                          M500,0 L400,430"/>

            </Canvas>


            <!-- ================= FLOATING CUBES ================= -->

            <Canvas>

                <Path x:Name="Cube1"
                      Fill="#00F2FE"
                      Data="M10,0 L20,5 L10,10 L0,5 Z"
                      Canvas.Left="120"
                      Canvas.Top="100">

                    <Path.RenderTransform>

                        <TranslateTransform/>

                    </Path.RenderTransform>

                    <Path.Effect>

                        <DropShadowEffect
                            Color="#00F2FE"
                            BlurRadius="15"
                            ShadowDepth="0"/>

                    </Path.Effect>

                </Path>


                <Path x:Name="Cube2"
                      Fill="#8A2BE2"
                      Data="M8,0 L16,4 L8,8 L0,4 Z"
                      Canvas.Left="500"
                      Canvas.Top="135">

                    <Path.RenderTransform>

                        <TranslateTransform/>

                    </Path.RenderTransform>

                    <Path.Effect>

                        <DropShadowEffect
                            Color="#8A2BE2"
                            BlurRadius="15"
                            ShadowDepth="0"/>

                    </Path.Effect>

                </Path>


                <Path x:Name="Cube3"
                      Fill="#00F2FE"
                      Data="M12,0 L24,6 L12,12 L0,6 Z"
                      Canvas.Left="150"
                      Canvas.Top="280">

                    <Path.RenderTransform>

                        <TranslateTransform/>

                    </Path.RenderTransform>

                    <Path.Effect>

                        <DropShadowEffect
                            Color="#00F2FE"
                            BlurRadius="18"
                            ShadowDepth="0"/>

                    </Path.Effect>

                </Path>

            </Canvas>


            <!-- ================= MAIN CONTENT ================= -->

            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center">


                <!-- TITLE -->

                <TextBlock x:Name="TitleText"
                           Text="Downloading..."
                           Foreground="White"
                           FontSize="22"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,8"/>


                <!-- CIRCULAR PROGRESS -->

                <Grid Width="230"
                      Height="230">


                    <!-- GLOW -->

                    <Ellipse x:Name="CoreGlow"
                             Width="175"
                             Height="175"
                             Fill="#00F2FE"
                             Opacity="0.12">

                        <Ellipse.Effect>

                            <BlurEffect
                                Radius="45"/>

                        </Ellipse.Effect>

                    </Ellipse>


                    <!-- OUTER RING -->

                    <Ellipse x:Name="OuterRing"
                             Width="220"
                             Height="220"
                             Stroke="#00F2FE"
                             StrokeThickness="2"
                             StrokeDashArray="2 7"
                             Opacity="0.65"
                             RenderTransformOrigin="0.5,0.5">

                        <Ellipse.RenderTransform>

                            <RotateTransform
                                Angle="0"/>

                        </Ellipse.RenderTransform>

                    </Ellipse>


                    <!-- INNER RING -->

                    <Ellipse x:Name="InnerRing"
                             Width="198"
                             Height="198"
                             Stroke="#8A2BE2"
                             StrokeThickness="3"
                             StrokeDashArray="1 9"
                             Opacity="0.8"
                             RenderTransformOrigin="0.5,0.5">

                        <Ellipse.RenderTransform>

                            <RotateTransform
                                Angle="0"/>

                        </Ellipse.RenderTransform>

                    </Ellipse>


                    <!-- BACKGROUND PROGRESS RING -->

                    <Ellipse Width="175"
                             Height="175"
                             Stroke="#2500F2FE"
                             StrokeThickness="12"/>


                    <!-- MAIN MOVING PROGRESS RING -->

                    <Ellipse x:Name="MainProgressRing"
                             Width="175"
                             Height="175"
                             Stroke="{StaticResource ProgressGradient}"
                             StrokeThickness="11"
                             StrokeDashArray="32 100"
                             StrokeDashCap="Round"
                             RenderTransformOrigin="0.5,0.5">

                        <Ellipse.RenderTransform>

                            <RotateTransform
                                Angle="135"/>

                        </Ellipse.RenderTransform>

                        <Ellipse.Effect>

                            <DropShadowEffect
                                Color="#00F2FE"
                                BlurRadius="18"
                                ShadowDepth="0"
                                Opacity="0.9"/>

                        </Ellipse.Effect>

                    </Ellipse>


                    <!-- CENTER TEXT -->

                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">

                        <TextBlock x:Name="ProgressText"
                                   Text="0%"
                                   Foreground="White"
                                   FontSize="48"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center">

                            <TextBlock.Effect>

                                <DropShadowEffect
                                    Color="#00F2FE"
                                    BlurRadius="15"
                                    ShadowDepth="0"/>

                            </TextBlock.Effect>

                        </TextBlock>


                        <TextBlock Text="جاري التحميل..."
                                   Foreground="White"
                                   FontSize="14"
                                   Opacity="0.8"
                                   HorizontalAlignment="Center"/>

                    </StackPanel>

                </Grid>


                <!-- STATUS -->

                <TextBlock x:Name="StatusText"
                           Text="Preparing download..."
                           Foreground="{StaticResource TextMuted}"
                           FontSize="13"
                           HorizontalAlignment="Center"
                           Margin="0,12,0,0"/>


                <!-- LINEAR PROGRESS -->

                <Border Width="440"
                        Height="14"
                        Margin="0,18,0,0"
                        Background="#1A2235"
                        CornerRadius="7"
                        BorderBrush="#40FFFFFF"
                        BorderThickness="1">

                    <ProgressBar x:Name="DownloadProgressBar"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="0"
                                 Height="12"
                                 BorderThickness="0">

                        <ProgressBar.Foreground>

                            <LinearGradientBrush
                                StartPoint="0,0"
                                EndPoint="1,0">

                                <GradientStop
                                    Color="#00F2FE"
                                    Offset="0"/>

                                <GradientStop
                                    Color="#4FACFE"
                                    Offset="0.5"/>

                                <GradientStop
                                    Color="#8A2BE2"
                                    Offset="1"/>

                            </LinearGradientBrush>

                        </ProgressBar.Foreground>

                    </ProgressBar>

                </Border>


                <!-- DOWNLOAD INFO -->

                <Grid Width="440"
                      Margin="0,10,0,0">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition/>

                        <ColumnDefinition/>

                    </Grid.ColumnDefinitions>


                    <TextBlock x:Name="SizeText"
                               Text="0 B / Calculating..."
                               Foreground="#AAAAAA"
                               FontSize="12"/>


                    <TextBlock x:Name="SpeedText"
                               Text="0 KB/s"
                               Grid.Column="1"
                               HorizontalAlignment="Right"
                               Foreground="#AAAAAA"
                               FontSize="12"/>

                </Grid>


                <!-- REMAINING TIME + CANCEL -->

                <Grid Width="440"
                      Margin="0,8,0,0">

                    <TextBlock x:Name="RemainingText"
                               Text="Calculating..."
                               Foreground="#AAAAAA"
                               FontSize="12"
                               VerticalAlignment="Center"/>


                    <Button Content="CANCEL"
                            Style="{StaticResource CancelButton}"
                            HorizontalAlignment="Center"
                            Click="Cancel_Click"/>

                </Grid>

            </StackPanel>

        </Grid>

    </Border>

</Window>