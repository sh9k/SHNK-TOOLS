<Window x:Class="SHNK.Tools.App.DownloadProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="520"
        Height="250"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False">

    <Window.Resources>

        <LinearGradientBrush x:Key="RgbBrush"
                             StartPoint="0,0"
                             EndPoint="1,1">
            <GradientStop Color="#FFFF3B3B" Offset="0"/>
            <GradientStop Color="#FF3BD7FF" Offset="0.5"/>
            <GradientStop Color="#FF7A3BFF" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="CancelButton"
               TargetType="Button">

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="Background"
                    Value="#22FFFFFF"/>

            <Setter Property="BorderBrush"
                    Value="#55FFFFFF"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="Padding"
                    Value="18,7"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

    </Window.Resources>

    <Border CornerRadius="22"
            BorderThickness="2"
            BorderBrush="{StaticResource RgbBrush}"
            Background="#F0101018">

        <Border.Effect>

            <DropShadowEffect
                BlurRadius="30"
                ShadowDepth="0"
                Opacity="0.8"/>

        </Border.Effect>

        <Grid Margin="24">

            <Grid.RowDefinitions>

                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>

            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">

                <TextBlock x:Name="TitleText"
                           Text="Downloading..."
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="White"/>

                <TextBlock x:Name="StatusText"
                           Text="Preparing download..."
                           Margin="0,5,0,0"
                           Foreground="#99FFFFFF"
                           FontSize="12"/>

            </StackPanel>

            <ProgressBar Grid.Row="1"
                         x:Name="DownloadProgressBar"
                         Height="14"
                         Margin="0,20,0,12"
                         Minimum="0"
                         Maximum="100"
                         Value="0">

                <ProgressBar.Foreground>

                    <LinearGradientBrush
                        StartPoint="0,0"
                        EndPoint="1,0">

                        <GradientStop Color="#FF3BD7FF"
                                      Offset="0"/>

                        <GradientStop Color="#FF7A3BFF"
                                      Offset="0.5"/>

                        <GradientStop Color="#FFFF3BD7"
                                      Offset="1"/>

                    </LinearGradientBrush>

                </ProgressBar.Foreground>

            </ProgressBar>

            <Grid Grid.Row="2">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition/>
                    <ColumnDefinition/>

                </Grid.ColumnDefinitions>

                <TextBlock x:Name="ProgressText"
                           Text="0%"
                           Foreground="White"
                           FontSize="14"
                           FontWeight="Bold"/>

                <TextBlock x:Name="SpeedText"
                           Grid.Column="1"
                           Text="0 B/s"
                           Foreground="#BBBBBB"
                           HorizontalAlignment="Right"/>

            </Grid>

            <Grid Grid.Row="3"
                  Margin="0,8,0,0">

                <TextBlock x:Name="SizeText"
                           Foreground="#AAAAAA"
                           Text="0 MB / Calculating..."/>

                <TextBlock x:Name="RemainingText"
                           Foreground="#AAAAAA"
                           HorizontalAlignment="Right"
                           Text="Calculating..."/>

            </Grid>

            <StackPanel Grid.Row="4"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,18,0,0">

                <Button Content="CANCEL"
                        Style="{StaticResource CancelButton}"
                        Click="Cancel_Click"/>

            </StackPanel>

        </Grid>

    </Border>

</Window>